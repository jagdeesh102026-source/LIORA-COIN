# ==============================================================================
# LIORA COIN — Environment Variables Configuration Template
# DO NOT COMMIT SECRETS OR PRIVATE KEYS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# Network & RPC Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CHAIN_ID=97
NEXT_PUBLIC_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/
NEXT_PUBLIC_EXPLORER_URL=https://testnet.bscscan.com

# ------------------------------------------------------------------------------
# Deployed Contract Addresses (BSC Testnet Defaults)
# ------------------------------------------------------------------------------
# Canonical UUPS LIORA Token Proxy
NEXT_PUBLIC_LIORA_PROXY_ADDRESS=0xC0aecDF4747C61AAbA1963bc90Ca9Fa16EDF16F9
NEXT_PUBLIC_LIORA_TIMELOCK_ADDRESS=0xDa79b818566fcE9D8123817dc291f4E0DE626A27
NEXT_PUBLIC_LIORA_RESERVE_VAULT_ADDRESS=0x1E10a2bFcA618Ed3EFEf732f4352A774586FC320

# PancakeSwap V2 Testnet Pool
NEXT_PUBLIC_LIORA_PANCAKESWAP_PAIR=0x41F48008a9f0B8b0825B341c2c31825B572B2841
NEXT_PUBLIC_MOCK_USDT_ADDRESS=0x83A1b8696cAE9c72e48A44F754714f3aE755D6f6

# Legacy/Historical Token Reference
NEXT_PUBLIC_OXENIQ_CONTRACT_ADDRESS=
NEXT_PUBLIC_ALLOCATION_CONTRACT_ADDRESS=

# ------------------------------------------------------------------------------
# Blockchain Deployment & Verification Keys
# ------------------------------------------------------------------------------
# DEPLOYER_PRIVATE_KEY: Used strictly for local simulation (Chain ID 31337) and BSC Testnet (Chain ID 97)
# NEVER attach or commit mainnet private keys.
DEPLOYER_PRIVATE_KEY=
BSCSCAN_API_KEY=

# ------------------------------------------------------------------------------
# Mainnet Deployment & Governance Gates (SEC-07 Safeguards)
# ------------------------------------------------------------------------------
ENABLE_MAINNET_DEPLOYMENT=false
MAINNET_DEPLOYER_PRIVATE_KEY=
LIORA_MAINNET_OPERATING_TREASURY=0xD546c3263663C193447bAdF60741f3915b349064
LIORA_MAINNET_SAFE_MULTISIG=
LIORA_MAINNET_TIMELOCK_DELAY=172800

# ------------------------------------------------------------------------------
# Database & Persistence Configuration
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Used by Prisma ORM and production migrations)
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/liora_production?schema=public

# Application Persistence Mode ("memory" for local dev/mocks, "postgres" for live database)
OXENIQ_PERSISTENCE_MODE=memory

# ------------------------------------------------------------------------------
# Initial Administrator Provisioning & Session Security
# ------------------------------------------------------------------------------
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_MFA_SECRET=

# Server Session Security
SESSION_SECRET=
ADMIN_SECRET=
